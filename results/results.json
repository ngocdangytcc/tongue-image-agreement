{
 "about": "Public results file for: Tang HK, Vo TT, Tran DN. Agreement between a deep-learning reader of smartphone tongue photographs and a five-expert traditional-medicine panel. Diagnostics (submitted). No patient-level data, identifiers or photographs.",
 "n_patients_evaluated": 1220,
 "cohort": {
  "patients_photographed": 1226,
  "pilot_patients_excluded": 6,
  "pilot_reason": "photographed on 17-18 December 2024 during a pilot of the photography protocol, before formal recruitment",
  "patients_analysed": 1220,
  "dorsal_photographs_analysed": 2440,
  "capture_window_analysed": "4 January to 31 December 2025 (EXIF); 7 patients without an EXIF date",
  "site": "University Medical Center Ho Chi Minh City, Vietnam",
  "ethics": "Board of Ethics in Biomedical Research, University of Medicine and Pharmacy at Ho Chi Minh City, Decision No. 3911/ĐHYD-HĐĐĐ, 2 December 2024",
  "training_note": "Models trained on all 1,226 patients under patient-grouped 5-fold CV; the six pilot patients are excluded from evaluation only. Their photographs were in the training folds of the other four folds."
 },
 "rating": {
  "panel": "five traditional-medicine physicians, majority vote",
  "experience": "mean 10.8 years (range 7 to 14)",
  "standardisation_meeting_ict": "2025-01-06",
  "modality": "Tongue signs rated from the tongue photographs; tongue movement rated from the tongue video. The model received only the two dorsal photographs."
 },
 "model": {
  "backbone": "efficientnet_b0",
  "pretrained_on": "ImageNet",
  "img_size": 384,
  "batch_size": 32,
  "optimizer": "AdamW",
  "lr": 0.0003,
  "weight_decay": 0.0001,
  "scheduler": "OneCycleLR, pct_start 0.25",
  "mixed_precision": true,
  "dropout": 0.2,
  "n_heads": 15,
  "seed": 20260915,
  "cv": "patient-grouped 5-fold StratifiedGroupKFold, stratified on arm x EXIF capture month",
  "primary_epochs": 6,
  "robustness_epochs": 12,
  "config_hash_primary": "5a2b7673b283",
  "config_hash_robustness": "b1ba0615f548",
  "aggregation": "the two dorsal photographs per patient are averaged before scoring",
  "threshold_rule": "binary signs thresholded so predicted prevalence matches observed prevalence",
  "runtime": "Google Colab Pro, NVIDIA L4",
  "train_minutes_primary": 7,
  "train_minutes_robustness": 12
 },
 "environment": {
  "python": "3.13.15",
  "torch": "2.11.0+cu128",
